# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillfinance

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Application ──
DEBUG=true
APP_NAME="Skill Finance Score API"

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000"]

# ── AI (PydanticAI) ──
SCORING_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── GitHub API ──
GITHUB_APP_TOKEN=ghp_your-token-here

# ── Session ──
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=session_id

# ── File Upload ──
MAX_FILE_SIZE_MB=10
MAX_TOTAL_FILE_SIZE_MB=50
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
